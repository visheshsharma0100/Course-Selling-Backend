PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017/skillstack
# Set one of these. JWT_SECRET is preferred for new environments.
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Razorpay tutor-plan payments. Use Test-mode keys while developing.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Course-sale split for tutor-owned courses. Admin-owned courses remain 100%
# platform revenue. The backend clamps this value to the 0-100 range.
PLATFORM_COMMISSION_PERCENT=15
# Optional cache: start Redis locally, then set this URL. The app keeps working
# without Redis and bypasses caching when this value is absent.
REDIS_URL=redis://127.0.0.1:6379

# Local MP4 lesson uploads. Set lower in production when using local storage.
MAX_COURSE_VIDEO_SIZE_MB=1024

# Local-development only. Never enable this in production; it activates a
# clearly-labelled test tutor plan without charging or contacting Razorpay.
ALLOW_DEVELOPMENT_TUTOR_SUBSCRIPTIONS=false
# Local-development only. Lets a learner unlock a course without Razorpay.
# Keep false for Razorpay Test/Live checkout and always false in production.
ALLOW_DEVELOPMENT_COURSE_PURCHASES=false

# Required only when running: npm run seed:admin
ADMIN_USERNAME=platform-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
